def get_user_sessions(filters):
    """Retrieve user session details with filters"""
    global conn
    for count in range(1, 4):
        try:
            cur = conn.cursor()
            
            query = "SELECT session_id, user_id, session_start_time, user_name, department FROM edoct.user_session_details WHERE 1=1"
            params = []
            
            if filters.get('session_id'):
                query += " AND session_id = %s"
                params.append(filters['session_id'])
            
            if filters.get('user_id'):
                query += " AND user_id = %s"
                params.append(filters['user_id'])
            
            if filters.get('start_date'):
                query += " AND session_start_time >= %s"
                params.append(filters['start_date'])
            
            if filters.get('end_date'):
                query += " AND session_start_time <= %s"
                params.append(filters['end_date'])
            
            query += " ORDER BY session_start_time DESC LIMIT %s OFFSET %s"
            params.extend([filters.get('limit', 100), filters.get('offset', 0)])
            
            cur.execute(query, tuple(params))
            columns = [desc[0] for desc in cur.description]
            results = cur.fetchall()
            
            sessions = [dict(zip(columns, row)) for row in results]
            
            cur.close()
            logger.info(f"Retrieved {len(sessions)} sessions")
            return sessions
            
        except Exception as e:
            logger.exception(f"db read operation unsuccessful; retry count: {count}")
            time.sleep(1)
            conn = get_connection()
    else:
        logger.critical("db connection failure, cannot read sessions")
    return None


def get_document_stats(filters):
    """Retrieve document statistics with filters"""
    global conn
    for count in range(1, 4):
        try:
            cur = conn.cursor()
            
            query = """SELECT session_id, upload_mode, document_file_name, document_type, 
                       doc_tag_res, classification_start_time, classification_end_time, 
                       is_discarded, document_upload_time, prediction_score, classified_by, 
                       correlation_id 
                       FROM edoct.user_uploaded_document_details WHERE 1=1"""
            params = []
            
            if filters.get('session_id'):
                query += " AND session_id = %s"
                params.append(filters['session_id'])
            
            if filters.get('user_id'):
                # Join with session table for user_id filtering
                query = query.replace("WHERE 1=1", 
                    """INNER JOIN edoct.user_session_details USING (session_id) WHERE 1=1 
                    AND user_id = %s""")
                params.insert(0, filters['user_id'])
            
            if filters.get('document_type'):
                query += " AND document_type = %s"
